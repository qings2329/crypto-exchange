diff --git a/src/pages/FuturesManagement.tsx b/src/pages/FuturesManagement.tsx
new file mode 100644
index 0000000..c4a4f5a
--- /dev/null
+++ b/src/pages/FuturesManagement.tsx
@@ -0,0 +1,295 @@
+import { useCallback, useEffect, useState } from "react";
+
+/**
+ * 期货交易管理页面（管理后台 web-admin）
+ * --------------------------------------------------------------------------
+ * 对应后端 adminapi 新增的「期货交易管理」模块（代理 internal/futuresapi）：
+ *   读（需 futures:view）
+ *     GET  /api/admin/futures/positions          持仓列表（支持 ?user_id=&symbol=）
+ *     GET  /api/admin/futures/funding            当前资金费率
+ *     GET  /api/admin/futures/funding-history    资金费率历史
+ *   写（需 futures:manage，高危）
+ *     POST /api/admin/futures/deposit                         手工入账（给某用户信用期货账户）
+ *     POST /api/admin/futures/withdraw/chain                 代客直提（链上提现，经风控引擎）
+ *     POST /api/admin/futures/withdraw/emergency/freeze      全局紧急冻结出金
+ *     POST /api/admin/futures/withdraw/emergency/resume      全局解冻
+ *     POST /api/admin/futures/risk/enable                    风控引擎开关/阈值
+ *     POST /api/admin/futures/baddebt/socialize/propose      坏账社会化分摊提案
+ *     POST /api/admin/futures/baddebt/socialize/approve      坏账分摊审批执行
+ *
+ * 约定（按你们 web-admin 实际约定调整）：
+ *   - `api.get/post` 已自动附加 admin token，并返回完整信封 {code,data,message}，这里统一用 `.data` 取业务数据。
+ *   - 鉴权报错（401/403）由全局拦截器处理，本页只展示业务 error。
+ *   - 写操作一律高危，会二次确认。仅 futures:view 账号看不到这些按钮（后端也会 403 双保险）。
+ *   - 样式用了内联 style 占位，请替换为你们实际的 UI 组件库（Ant Design / MUI 等）。
+ *   - 写操作返回的业务数据字段不固定，统一以 JSON 原文展示，便于临时核查。
+ */
+
+type DepositReq = { user_id: number; amount: number };
+type WithdrawChainReq = {
+  user_id: number;
+  asset: string;
+  chain: string;
+  amount: number;
+  address: string;
+  fee?: number;
+};
+type RiskEnableReq = {
+  enabled: boolean;
+  auto_freeze: boolean;
+  window_sec: number;
+  velocity_amount: number;
+  velocity_count: number;
+  addr_burst: number;
+};
+type SocializeReq = { asset: string; proposal_id?: string };
+
+const card: React.CSSProperties = {
+  border: "1px solid #e5e7eb",
+  borderRadius: 8,
+  padding: 16,
+  marginBottom: 16,
+};
+const btn: React.CSSProperties = { marginLeft: 8, padding: "4px 10px" };
+const dangerBtn: React.CSSProperties = {
+  ...btn,
+  color: "#fff",
+  background: "#b91c1c",
+  border: "1px solid #b91c1c",
+  cursor: "pointer",
+};
+const okBtn: React.CSSProperties = {
+  ...btn,
+  color: "#fff",
+  background: "#16a34a",
+  border: "1px solid #16a34a",
+  cursor: "pointer",
+};
+const inputStyle: React.CSSProperties = { marginLeft: 4, marginRight: 8, padding: "2px 6px" };
+
+export default function FuturesManagement() {
+  const [error, setError] = useState<string | null>(null);
+  const [raw, setRaw] = useState<any>(null); // 写操作返回的 data 原文
+
+  // 读：持仓过滤
+  const [posUser, setPosUser] = useState("");
+  const [posSymbol, setPosSymbol] = useState("");
+  const [positions, setPositions] = useState<any>(null);
+  const [funding, setFunding] = useState<any>(null);
+  const [fundingHistory, setFundingHistory] = useState<any>(null);
+
+  // 写：表单
+  const [dep, setDep] = useState<DepositReq>({ user_id: 1, amount: 1000 });
+  const [wd, setWd] = useState<WithdrawChainReq>({
+    user_id: 1,
+    asset: "USDT",
+    chain: "tron",
+    amount: 10,
+    address: "",
+  });
+  const [risk, setRisk] = useState<RiskEnableReq>({
+    enabled: true,
+    auto_freeze: false,
+    window_sec: 60,
+    velocity_amount: 50000,
+    velocity_count: 20,
+    addr_burst: 5,
+  });
+  const [socialize, setSocialize] = useState<SocializeReq>({ asset: "USDT" });
+  const [lastProposal, setLastProposal] = useState<string>("");
+
+  const loadPositions = useCallback(async () => {
+    setError(null);
+    try {
+      const q = new URLSearchParams();
+      if (posUser) q.set("user_id", posUser);
+      if (posSymbol) q.set("symbol", posSymbol);
+      const r = await api.get(`/futures/positions?${q.toString()}`);
+      setPositions(r.data);
+    } catch (e: any) {
+      setError(e?.message ?? "持仓加载失败");
+    }
+  }, [posUser, posSymbol]);
+
+  const loadFunding = useCallback(async () => {
+    setError(null);
+    try {
+      const r = await api.get("/futures/funding");
+      setFunding(r.data);
+    } catch (e: any) {
+      setError(e?.message ?? "资金费率加载失败");
+    }
+  }, []);
+
+  const loadFundingHistory = useCallback(async () => {
+    setError(null);
+    try {
+      const r = await api.get("/futures/funding-history");
+      setFundingHistory(r.data);
+    } catch (e: any) {
+      setError(e?.message ?? "资金费率历史加载失败");
+    }
+  }, []);
+
+  useEffect(() => {
+    loadPositions();
+    loadFunding();
+    loadFundingHistory();
+  }, [loadPositions, loadFunding, loadFundingHistory]);
+
+  const runWrite = async (path: string, body: any, confirmMsg?: string) => {
+    if (confirmMsg && !window.confirm(confirmMsg)) return;
+    setError(null);
+    setRaw(null);
+    try {
+      const r = await api.post(path, body);
+      setRaw(r.data);
+    } catch (e: any) {
+      setError(e?.message ?? "操作失败");
+    }
+  };
+
+  return (
+    <div style={{ padding: 24, maxWidth: 1040, margin: "0 auto" }}>
+      <h1>期货交易管理</h1>
+      <p style={{ color: "#6b7280" }}>
+        读需 <code>futures:view</code>；写（充值 / 代客直提 / 应急冻结 / 风控开关 / 坏账分摊）需 <code>futures:manage</code>。
+      </p>
+      {error && <div style={{ color: "#b91c1c", marginBottom: 12 }}>错误：{error}</div>}
+      {raw && (
+        <pre style={{ background: "#f3f4f6", padding: 12, borderRadius: 6, overflow: "auto" }}>
+          {JSON.stringify(raw, null, 2)}
+        </pre>
+      )}
+
+      {/* 读：持仓 / 资金费 */}
+      <section style={card}>
+        <h2>持仓 / 资金费（只读）</h2>
+        <h3>持仓列表</h3>
+        <div>
+          <label>user_id<input style={inputStyle} value={posUser} onChange={(e) => setPosUser(e.target.value)} placeholder="留空=全部" /></label>
+          <label>symbol<input style={inputStyle} value={posSymbol} onChange={(e) => setPosSymbol(e.target.value)} placeholder="如 BTCUSDT" /></label>
+          <button style={okBtn} onClick={loadPositions}>刷新持仓</button>
+        </div>
+        <pre style={{ background: "#f3f4f6", padding: 12, borderRadius: 6, overflow: "auto" }}>
+          {positions ? JSON.stringify(positions, null, 2) : "（加载中…）"}
+        </pre>
+        <h3>当前资金费率</h3>
+        <pre style={{ background: "#f3f4f6", padding: 12, borderRadius: 6, overflow: "auto" }}>
+          {funding ? JSON.stringify(funding, null, 2) : "（加载中…）"}
+        </pre>
+        <button style={okBtn} onClick={loadFundingHistory}>刷新资金费率历史</button>
+        <pre style={{ background: "#f3f4f6", padding: 12, borderRadius: 6, overflow: "auto" }}>
+          {fundingHistory ? JSON.stringify(fundingHistory, null, 2) : "（加载中…）"}
+        </pre>
+      </section>
+
+      {/* 写：手工充值 */}
+      <section style={card}>
+        <h2>手工入账（高危）</h2>
+        <div>
+          <label>user_id<input style={inputStyle} type="number" value={dep.user_id} onChange={(e) => setDep({ ...dep, user_id: +e.target.value })} /></label>
+          <label>amount<input style={inputStyle} type="number" value={dep.amount} onChange={(e) => setDep({ ...dep, amount: +e.target.value })} /></label>
+          <button
+            style={dangerBtn}
+            onClick={() => runWrite("/futures/deposit", dep, `确认给 user ${dep.user_id} 信用期货账户入账 ${dep.amount} USDT？`)}
+          >
+            执行充值
+          </button>
+        </div>
+      </section>
+
+      {/* 写：代客直提 */}
+      <section style={card}>
+        <h2>代客直提（链上提现，经风控引擎）</h2>
+        <div>
+          <label>user_id<input style={inputStyle} type="number" value={wd.user_id} onChange={(e) => setWd({ ...wd, user_id: +e.target.value })} /></label>
+          <label>asset<input style={inputStyle} value={wd.asset} onChange={(e) => setWd({ ...wd, asset: e.target.value })} /></label>
+          <label>chain<input style={inputStyle} value={wd.chain} onChange={(e) => setWd({ ...wd, chain: e.target.value })} /></label>
+          <label>amount<input style={inputStyle} type="number" value={wd.amount} onChange={(e) => setWd({ ...wd, amount: +e.target.value })} /></label>
+          <label>address<input style={inputStyle} value={wd.address} onChange={(e) => setWd({ ...wd, address: e.target.value })} /></label>
+        </div>
+        <button
+          style={dangerBtn}
+          onClick={() => runWrite("/futures/withdraw/chain", wd, `确认代客直提 ${wd.amount} ${wd.asset} 到 ${wd.address}？该操作冻结目标用户余额并经风控引擎`)}
+        >
+          执行代客直提
+        </button>
+      </section>
+
+      {/* 写：应急冻结 / 解冻 */}
+      <section style={card}>
+        <h2>全局出金应急开关（高危）</h2>
+        <div>
+          <button
+            style={dangerBtn}
+            onClick={() => runWrite("/futures/withdraw/emergency/freeze", {}, "确认全局冻结所有出金受理？")}
+          >
+            紧急冻结出金
+          </button>
+          <button
+            style={okBtn}
+            onClick={() => runWrite("/futures/withdraw/emergency/resume", {}, "确认解除全局冻结并清零风控自动冻结标记？")}
+          >
+            解除冻结
+          </button>
+        </div>
+      </section>
+
+      {/* 写：风控开关 */}
+      <section style={card}>
+        <h2>风控引擎开关 / 阈值</h2>
+        <div>
+          <label>enabled<input type="checkbox" checked={risk.enabled} onChange={(e) => setRisk({ ...risk, enabled: e.target.checked })} /></label>
+          <label>auto_freeze<input type="checkbox" checked={risk.auto_freeze} onChange={(e) => setRisk({ ...risk, auto_freeze: e.target.checked })} /></label>
+          <label>window_sec<input style={inputStyle} type="number" value={risk.window_sec} onChange={(e) => setRisk({ ...risk, window_sec: +e.target.value })} /></label>
+          <label>velocity_amount<input style={inputStyle} type="number" value={risk.velocity_amount} onChange={(e) => setRisk({ ...risk, velocity_amount: +e.target.value })} /></label>
+          <label>velocity_count<input style={inputStyle} type="number" value={risk.velocity_count} onChange={(e) => setRisk({ ...risk, velocity_count: +e.target.value })} /></label>
+          <label>addr_burst<input style={inputStyle} type="number" value={risk.addr_burst} onChange={(e) => setRisk({ ...risk, addr_burst: +e.target.value })} /></label>
+        </div>
+        <button style={okBtn} onClick={() => runWrite("/futures/risk/enable", risk)}>应用风控配置</button>
+      </section>
+
+      {/* 写：坏账社会化分摊 */}
+      <section style={card}>
+        <h2>坏账社会化分摊治理（两步审批）</h2>
+        <div>
+          <label>asset<input style={inputStyle} value={socialize.asset} onChange={(e) => setSocialize({ ...socialize, asset: e.target.value })} /></label>
+          <button
+            style={okBtn}
+            onClick={async () => {
+              const body = { asset: socialize.asset };
+              setError(null);
+              setRaw(null);
+              try {
+                const r = await api.post("/futures/baddebt/socialize/propose", body);
+                setRaw(r.data);
+                if (r.data?.proposal_id) setLastProposal(String(r.data.proposal_id));
+              } catch (e: any) {
+                setError(e?.message ?? "提案失败");
+              }
+            }}
+          >
+            发起分摊提案
+          </button>
+        </div>
+        <div style={{ marginTop: 8 }}>
+          <label>proposal_id<input style={inputStyle} value={lastProposal} onChange={(e) => setLastProposal(e.target.value)} placeholder="由提案返回" /></label>
+          <button
+            style={dangerBtn}
+            onClick={() => runWrite("/futures/baddebt/socialize/approve",
+              { asset: socialize.asset, proposal_id: lastProposal }, "确认执行坏账社会化分摊？该操作从全体持仓用户按比例扣减以冲抵穿仓损失")}
+          >
+            审批执行分摊
+          </button>
+        </div>
+      </section>
+    </div>
+  );
+}
+
+// 与 web-admin 的 api 客户端对齐：这里仅做类型占位，编译时请确保 import 你们真实的 api 模块。
+declare const api: {
+  get: (p: string) => Promise<any>;
+  post: (p: string, body: any) => Promise<any>;
+};
