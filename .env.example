# 链上 RPC 真实节点 URL 与离线签名私钥注入示例（生产部署用）
# 复制为 .env 并填入真实值；本文件仅作模板，不含任何真实密钥。.env 已被 .gitignore 忽略。

# ---- 链上 RPC 总开关（true/false）----
CHAIN_RPC_ENABLED=true
CHAIN_RPC_REQUIRED_CONFIRMATIONS=2
CHAIN_RPC_POLL_INTERVAL_SEC=2

# ---- 各链真实节点 URL（常含 API key，务必走环境变量，勿写进 configs/config.yaml）----
# ETH：自建 geth http://127.0.0.1:8545；或托管节点（key 嵌路径）
# CHAIN_RPC_ENDPOINT_ETH=https://eth-mainnet.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
# BTC：bitcoind RPC（user:pass 自动转为 Basic Auth），或自托管
# CHAIN_RPC_ENDPOINT_BTC=http://<rpcuser>:<rpcpass>@127.0.0.1:8332
# TRON：java-tron 全节点 http://127.0.0.1:8090，或 TronGrid 公网
# CHAIN_RPC_ENDPOINT_TRON=https://api.trongrid.io

# ---- 离线签名边界（热钱包）----
# 设为 true 走「离线签名 → SendRaw 广播」；私钥/后端从环境变量注入，不落配置文件。
HOT_WALLET_ENABLED=true
HOT_WALLET_SIGNER_TYPE=hsm
# 软件后端用 "software"（SignerKey 为 32 字节 hex 私钥）；生产 HSM/KMS 用 "external"
# （SignerKey 作为 keyID，从 settlement.RegisterExternalSigner 取真实后端）。
HOT_WALLET_SIGNER_BACKEND=software
# 软件演示私钥（32 字节 hex，可选 0x 前缀）。生产切勿提交真实私钥，务必用环境变量注入；
# 留空则关闭真实签名、回退节点侧广播（fail-degraded）。
# HOT_WALLET_SIGNER_KEY=4646464646464646464646464646464646464646464646464646464646464646

# ETH 真实签名兜底默认值（生产主网建议对应 chainID 走 EIP-155；gas_price 优先取节点建议值）
HOT_WALLET_ETH_CHAIN_ID=1
HOT_WALLET_ETH_GAS_PRICE_WEI=0
HOT_WALLET_ETH_GAS_LIMIT=21000

# ---- 生产 HSM/KMS 后端连接配置 ----
# 当 HOT_WALLET_SIGNER_BACKEND=external 且全局注册表未命中时，按以下变量自动构造并注册
# 真实签名后端（无需手写 settlement.RegisterExternalSigner）。敏感字段（endpoint 可能含凭据、
# public_key）务必走环境变量，勿写进 configs/config.yaml。
# kind：当前支持 "remote-http"（内部签名服务「对 32 字节摘要做 ECDSA」的 HTTPS 端点，私钥不
#       离开安全模块）；aws-kms / pkcs11 等需自行实现 KeySigner 后用 RegisterExternalSigner 注入。
HSM_KIND=remote-http
# 内部签名服务「对摘要签名」的 HTTPS 端点；服务须对传入的 32 字节 digest 直接做 ECDSA（不再二次
# 哈希），返回 {r,s}(hex) 或 {signature: DER-hex}（与 ParseExternalDERSignature 兼容）。
# 例：https://hsm.internal/sign（可含鉴权凭据，勿提交真实值）
# 本仓库附带可部署的内部签名服务二进制：go run ./cmd/hsm-signing-service -addr :9100 -mode rs
# （启动即打印 HSM_KIND/HSM_ENDPOINT/HSM_PUBLIC_KEY，私钥持有在服务内、对外仅暴露对摘要签名）。
HSM_ENDPOINT=https://hsm.internal/sign
# 可选：作为 Bearer Token 注入 Authorization 头（内部服务鉴权）。
HSM_API_KEY=
# 安全模块导出的 secp256k1 公钥（hex，压缩 33 字节或 非压缩 65 字节），用于派生地址、推导 ETH
# recovery id、校验签名；必须与后端密钥对应（设备可导出，不涉密）。
# 例：0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798
HSM_PUBLIC_KEY=

# —— 充值地址 HD 派生（给用户生成充值地址）——
# 账户/外部链级扩展公钥（BIP44: m/44'/coin'/0'/0，base58 xpub 格式）。由 HSM 内 xprv 经硬化层级
# 派生后导出；进程只持此公钥，按 userID 做非硬化子派生，得到每用户独立的真实 ETH/BTC/TRON 地址。
# 私钥始终留在 HSM，进程绝不持有。属敏感信息，仅经环境变量注入，不写进 configs/config.yaml。
# 例（测试用派生 xpub，切勿用于生产）：
# DEPOSIT_XPUB=xpub6CRoJwNzGxgUQzq...
DEPOSIT_XPUB=
